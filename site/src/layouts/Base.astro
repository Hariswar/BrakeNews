---
// Page shell: fonts, sticky header with the current section marked, footer.
// layout: "narrow" (article pages, default), "wide" (lists), "bare" (page draws its own bands).
import "../styles/global.css";
// Self-hosted variable fonts (@fontsource-variable), Latin files only: two downloads, both
// preloaded, font-display swap, with measured fallbacks in global.css.
import newsreaderUrl from "@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url";
import publicSansUrl from "@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";

interface Props {
  title: string;
  description: string;
  layout?: "narrow" | "wide" | "bare";
}
const { title, description, layout = "narrow" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;

const NAV = [
  { href: "/reports/", label: "Reports", match: ["/reports", "/investigations"] },
  { href: "/vehicles/", label: "Vehicles", match: ["/vehicles"] },
  { href: "/method/", label: "How it works", match: ["/method"] },
];
const active = (match: string[]) => match.some((m) => path.startsWith(m));

const LATIN =
  "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329," +
  "U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD";
const fontFaces =
  `@font-face{font-family:"Newsreader";src:url("${newsreaderUrl}") format("woff2");` +
  `font-weight:200 800;font-style:normal;font-display:swap;unicode-range:${LATIN}}` +
  `@font-face{font-family:"Public Sans";src:url("${publicSansUrl}") format("woff2");` +
  `font-weight:100 900;font-style:normal;font-display:swap;unicode-range:${LATIN}}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1115" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={publicSansUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={newsreaderUrl} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header" data-header>
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="BrakeNews home">
          <svg class="brand-mark" width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
            <rect width="28" height="28" rx="7" class="mark-bg" />
            <path d="M6 18.5 11 13l3.5 3.5L22 9" class="mark-line" />
            <circle cx="22" cy="9" r="2.2" class="mark-dot" />
          </svg>
          <span class="brand-name">BrakeNews</span>
        </a>
        <span class="tagline">Owner complaints, read early</span>
        <button
          type="button"
          class="menu-btn"
          aria-expanded="false"
          aria-controls="site-nav"
          data-menu-btn
        >
          <span class="menu-open"><Icon name="menu" /></span>
          <span class="menu-close"><Icon name="close" /></span>
          <span class="menu-text">Menu</span>
        </button>
        <nav id="site-nav" class="site-nav" aria-label="Site">
          <ul>
            {NAV.map((n) => (
              <li>
                <a href={n.href} aria-current={active(n.match) ? "page" : undefined}>
                  {n.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      {layout === "bare" ? (
        <slot />
      ) : (
        <div class:list={["container", "page", { narrow: layout === "narrow" }]}>
          <slot />
        </div>
      )}
    </main>
    <Footer />
  </body>
</html>

<script>
  // Mobile menu: a disclosure button. Escape closes it and returns focus to the button.
  const header = document.querySelector<HTMLElement>("[data-header]");
  const btn = document.querySelector<HTMLButtonElement>("[data-menu-btn]");
  if (header && btn) {
    const set = (open: boolean) => {
      btn.setAttribute("aria-expanded", String(open));
      header.toggleAttribute("data-open", open);
    };
    btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") {
        set(false);
        btn.focus();
      }
    });
  }

  // Tooltips: keep them inside the viewport, and let Escape dismiss one without moving focus.
  for (const tip of document.querySelectorAll<HTMLElement>("[data-tip]")) {
    const body = tip.querySelector<HTMLElement>(".tip-body");
    if (!body) continue;
    const place = () => {
      tip.removeAttribute("data-dismissed");
      body.style.setProperty("--shift", "0px");
      // Measure once the tooltip is displayed (hover / focus styles apply first).
      requestAnimationFrame(() => {
        const r = body.getBoundingClientRect();
        if (!r.width) return;
        const margin = 12;
        let shift = 0;
        if (r.left < margin) shift = margin - r.left;
        else if (r.right > innerWidth - margin) shift = innerWidth - margin - r.right;
        body.style.setProperty("--shift", `${shift}px`);
      });
    };
    tip.addEventListener("pointerenter", place);
    tip.addEventListener("focusin", place);
    tip.addEventListener("keydown", (e) => {
      if (e.key === "Escape") tip.setAttribute("data-dismissed", "");
    });
  }
</script>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: var(--space-2);
    z-index: 100;
    padding: var(--space-2) var(--space-3);
    background: var(--surface);
    border-radius: var(--radius-sm);
    font-weight: 600;
  }
  .skip:focus {
    left: var(--space-3);
  }
  main {
    display: block;
    outline: none;
  }
  .page {
    padding-top: var(--space-5);
  }

  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
  }
  .brand-name {
    font-family: var(--font-display-stack);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .mark-bg {
    fill: var(--brand);
  }
  .mark-line {
    fill: none;
    stroke: #fff;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mark-dot {
    fill: #fff;
  }
  .tagline {
    font-size: var(--text-sm);
    color: var(--ink-3);
    padding-left: var(--space-3);
    border-left: 1px solid var(--border);
  }
  .site-nav {
    margin-left: auto;
  }
  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-1);
  }
  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .site-nav a:hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  .site-nav a[aria-current="page"] {
    color: var(--ink);
    background: var(--surface-2);
    box-shadow: inset 0 -2px 0 var(--link);
  }
  .menu-btn {
    display: none;
  }

  @media (max-width: 860px) {
    .tagline {
      display: none;
    }
  }
  @media (max-width: 640px) {
    /* With JavaScript the links fold behind a Menu button; without it they simply wrap. */
    :global(.js) .menu-btn {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      min-height: 44px;
      margin-left: auto;
      padding: 0 12px;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-sm);
      background: var(--surface);
      color: var(--ink);
      font: 600 var(--text-sm) / 1 var(--font-body-stack);
      cursor: pointer;
    }
    .menu-close {
      display: none;
    }
    .site-header[data-open] .menu-open {
      display: none;
    }
    .site-header[data-open] .menu-close {
      display: inline;
    }
    .menu-open,
    .menu-close {
      line-height: 0;
    }
    .header-inner {
      flex-wrap: wrap;
    }
    :global(.js) .site-nav {
      display: none;
      flex-basis: 100%;
      margin: 0;
      padding-bottom: var(--space-3);
    }
    .site-header[data-open] .site-nav {
      display: block;
    }
    :global(.js) .site-nav ul {
      flex-direction: column;
    }
    .site-nav a {
      width: 100%;
      font-size: var(--text-base);
    }
  }
</style>
