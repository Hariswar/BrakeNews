---
// One page per vehicle (make, model, model year) with enough complaints (pipeline/vehicles.py).
import { getCollection } from "astro:content";
import Base from "../../../../layouts/Base.astro";
import MonthlyChart from "../../../../components/MonthlyChart.astro";
import RecallItem from "../../../../components/RecallItem.astro";
import Crumbs from "../../../../components/Crumbs.astro";
import Icon from "../../../../components/Icon.astro";
import VehicleSystems from "../../../../components/VehicleSystems.astro";
import { categoryLabel, categoryOf } from "../../../../lib/categories";
import { makeName, modelName, monthLabel, nhtsaVehicleUrl, num, percent, plural, vehicleName } from "../../../../lib/format";
import {
  allModels, makeUrl, modelUrl, monthlyList, readable, themeName, yearUrl,
  type ModelRecord, type YearRecord,
} from "../../../../lib/vehicles";

export async function getStaticPaths() {
  const models = await allModels();
  return models.flatMap((m) =>
    m.years.map((y) => ({
      params: { make: m.make_slug, model: m.model_slug, year: String(y.model_year) },
      props: { m, y },
    })),
  );
}

interface Props {
  m: ModelRecord;
  y: YearRecord;
}
const { m, y } = Astro.props;
const [nhtsaMake, nhtsaModel] = y.nhtsa;
const v = { make: nhtsaMake, model: nhtsaModel, model_year: y.model_year };
const name = vehicleName({ make: m.make, model: m.model, model_year: y.model_year });

// Published investigation reports on this vehicle, by theme.
const reports = (await getCollection("investigations"))
  .map((e) => e.data)
  .filter((r) => r.vehicle.make === nhtsaMake && r.vehicle.model === nhtsaModel && r.vehicle.model_year === y.model_year);
const reportFor = new Map(reports.map((r) => [r.theme.id, r]));

const leading = [...y.themes].sort((a, b) => b.complaints - a.complaints).slice(0, 3);
const flagged = y.themes.filter((t) => t.flagged).sort((a, b) => b.complaints - a.complaints);
const MIN_RECENT = 3; // as signals.py: fewer recent complaints make the ratio noise
const recalls = y.recalls.map((id) => ({ id, ...m.recalls[id] })).filter((r) => r.date !== undefined)
  .sort((a, b) => Number(b.do_not_drive || b.park_outside) - Number(a.do_not_drive || a.park_outside) || (b.date ?? "").localeCompare(a.date ?? ""));
const urgent = recalls.filter((r) => r.do_not_drive || r.park_outside);
const urgentWarnings = [urgent.some((r) => r.do_not_drive) && "do-not-drive", urgent.some((r) => r.park_outside) && "park-outside"].filter(Boolean);

const severity = [
  plural(y.crashes, "crash", "crashes"),
  plural(y.fires, "fire"),
  `${plural(y.injured, "person", "people")} injured`,
  `${plural(y.deaths, "death")}`,
];

const description =
  `${num(y.complaints)} owner complaints and ${plural(recalls.length, "recall")} for the ${name}` +
  (flagged.length
    ? `, including ${plural(flagged.length, "flagged complaint pattern")} with no matched recall in this data.`
    : ": what owners report and which problems recalls cover.");
---

<Base title={`${name}: problems, complaints and recalls | BrakeNews`} description={description} layout="wide">
  <Crumbs items={[
    { label: "Vehicles", href: "/vehicles/" },
    { label: makeName(m.make), href: makeUrl(m) },
    { label: modelName(m.model), href: modelUrl(m) },
    { label: String(y.model_year) },
  ]} />

  <header class="vehicle-header">
    <p class="overline">Your vehicle report</p>
    <h1>{name}</h1>
    <p class="lead sub">The problems owners report. The recalls to check. The evidence behind each.</p>
    <div class="vehicle-meta small">
      <span><Icon name="calendar" size={16} /> NHTSA data through {monthLabel(m.data_through, true)}</span>
      <a href={nhtsaVehicleUrl(v)} rel="noopener">View original NHTSA data <Icon name="arrow-right" size={14} /></a>
      <a href="/vehicles/">Change vehicle</a>
    </div>
  </header>

  {urgent.length > 0 && (
    <aside class="callout callout-critical urgent" role="note">
      <Icon name="alert" size={22} />
      <div>
        <strong class="callout-title">Recall warnings: {urgentWarnings.join(" and ")}.</strong>
        Check whether your vehicle is affected at <a href="https://www.nhtsa.gov/recalls" rel="noopener">nhtsa.gov/recalls</a> with your VIN.
        See {urgent.map((r, i) => <>{i > 0 && ", "}NHTSA recall #<a href={`#recall-${r.id}`} class="mono">{r.id}</a></>)}.
      </div>
    </aside>
  )}

  <nav class="report-nav" aria-label="On this vehicle page">
    <a href="#overview">At a glance</a>
    <a href="#systems-title">Explore systems</a>
    <a href="#problems">All problems</a>
    <a href="#recalls">Recalls</a>
    <a href="#about">Sources &amp; method</a>
  </nav>

  <section class="overview" aria-labelledby="overview">
    <div class="overview-heading">
      <h2 id="overview">Your vehicle at a glance</h2>
      <p class="small muted">Complaint patterns and official recall records, kept distinct.</p>
    </div>
    <dl class="tiles">
      <div class="tile">
        <dt>Owner complaints</dt>
        <dd class="value num">{num(y.complaints)}</dd>
        <dd class="note">Received {monthLabel(y.first_received)} to {monthLabel(y.last_received)}</dd>
      </div>
      <div class="tile">
        <dt>Official recalls listed</dt>
        <dd class="value num"><a href="#recalls">{num(recalls.length)}</a></dd>
        <dd class="note">Naming this model year; check your VIN for applicability</dd>
      </div>
      <div class="tile">
        <dt>BrakeNews flagged problems</dt>
        <dd class="value num"><a href="#flagged-summary">{num(flagged.length)}</a></dd>
        <dd class="note">Statistical signals, not official defect findings or recalls</dd>
      </div>
    </dl>

    <aside class="next-step">
      <div><strong>Check whether a recall applies to your car</strong><p class="small">A model-year recall may cover only some vehicles. Use your VIN for an individual check, then explore the complaints and evidence below.</p></div>
      <a class="btn btn-primary" href="https://www.nhtsa.gov/recalls" rel="noopener">Check recalls by VIN <Icon name="arrow-right" size={16} /></a>
    </aside>

    <div class="summary-grid">
      <section class="summary-card panel" aria-labelledby="leading-summary">
        <p class="summary-label"><Icon name="file-check" size={18} /> Owner reports</p>
        <h3 id="leading-summary">Most reported problems</h3>
        {leading.length ? <ol class="summary-list ranked" role="list">
          {leading.map((t, i) => <li>
            <span class="rank num">{i + 1}</span>
            <div><a href={`#problem-${t.id}`}>{themeName(t.id)}</a><span class="summary-detail">{plural(t.complaints, "complaint")} · {percent(t.share)} of this vehicle’s complaints</span></div>
          </li>)}
        </ol> : <p class="small muted">No specific problem meets this page’s listing criteria.</p>}
        <a class="summary-footer link-arrow" href="#problems">See all reported problems <Icon name="arrow-right" size={16} /></a>
      </section>

      <section class="summary-card panel" aria-labelledby="recall-summary">
        <p class="summary-label"><Icon name="info" size={18} /> Official NHTSA records</p>
        <h3 id="recall-summary">Recalls to check</h3>
        {recalls.length ? <ul class="summary-list" role="list">
          {recalls.slice(0, 2).map((r) => <li><div>
            <a href={`#recall-${r.id}`}>Recall #{r.id}</a>
            {(r.do_not_drive || r.park_outside) && <strong class="summary-warning">{[r.do_not_drive && "Do not drive", r.park_outside && "Park outside"].filter(Boolean).join(" · ")}</strong>}
            <span class="summary-detail recall-excerpt">{readable(r.summary) ?? r.components.join(", ")}</span>
          </div></li>)}
        </ul> : <p class="small muted">No recalls naming this model year are listed in this data. This does not establish that your vehicle is free of safety problems.</p>}
        <a class="summary-footer link-arrow" href="#recalls">View recall details <Icon name="arrow-right" size={16} /></a>
      </section>

      <section class="summary-card panel" aria-labelledby="flagged-summary">
        <p class="summary-label"><Icon name="trend-up" size={18} /> BrakeNews signals</p>
        <h3 id="flagged-summary">Flagged complaint patterns</h3>
        <p class="small muted">Unusual complaint patterns with no matched recall yet. A flag does not mean a recall will happen.</p>
        {flagged.length ? <ul class="summary-list" role="list">
          {flagged.slice(0, 3).map((t) => <li><div>
            <a href={`#problem-${t.id}`}>{themeName(t.id)}</a>
            <span class="summary-detail">{t.flagged_since ? `First signal: ${monthLabel(t.flagged_since)}` : "Flagged"}{t.rising && " · Recent surge"}</span>
            {reportFor.get(t.id) && <a class="investigation-link" href={`/investigations/${reportFor.get(t.id)!.slug}/`}>Read AI investigation</a>}
          </div></li>)}
        </ul> : <p class="small muted">No problems currently meet BrakeNews’s flagging criteria. This is not a safety rating.</p>}
        <a class="summary-footer link-arrow" href="/method/">How flags are identified <Icon name="arrow-right" size={16} /></a>
      </section>
    </div>
    <p class="small muted context-note">Complaint counts reflect reports submitted to NHTSA, not failure rates or a reliability ranking. Reported in these complaints: {severity.join(", ")}.</p>
  </section>

  {reports.length > 0 && (
    <aside class="callout reports">
      <Icon name="file-check" size={22} />
      <div>
        <strong class="callout-title">{reports.length === 1 ? "AI investigation report" : "AI investigation reports"}</strong>
        <p class="small">Written and checked by AI, with no human review. <a href="/method/#checks">How reports are made</a>.</p>
        <ul>
          {reports.map((r) => (
            <li><a href={`/investigations/${r.slug}/`}>{r.theme.name}</a>: {r.reading.label.toLowerCase()}</li>
          ))}
        </ul>
      </div>
    </aside>
  )}

  <VehicleSystems themes={y.themes} />

  <section aria-labelledby="complaint-history">
    <h2 id="complaint-history">Complaint history</h2>
    <p class="small muted">When NHTSA received these reports. Changes in reporting alone do not establish a change in failure rates.</p>
    <MonthlyChart monthly={monthlyList(y.monthly)} through={m.data_through} caption={`Complaints received about the ${name}`} />
  </section>

  <section aria-labelledby="problems">
    <h2 id="problems">Problems owners report</h2>
    <p class="small muted">Listed groups have at least 3 complaints. The page includes the 20 largest groups plus any additional flagged groups; some complaints are not assigned to a group.</p>
    {y.themes.length === 0 ? (
      <p>None of this vehicle's complaints fall into a specific problem often enough to list.</p>
    ) : (
      <>
        <div class="table-wrap">
          <table class="problems">
            <thead>
              <tr>
                <th scope="col">Problem</th>
                <th scope="col" class="r">Complaints</th>
                <th scope="col" class="r">Share</th>
                <th scope="col" class="r"><abbr title="This problem’s share of this vehicle’s complaints divided by its share of other vehicles’ complaints, over the last 24 months">Share ratio</abbr></th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <tbody>
              {y.themes.map((t) => {
                const report = reportFor.get(t.id);
                return (
                  <tr id={`problem-${t.id}`} class={t.flagged ? "flagged" : undefined} tabindex="-1">
                    <th scope="row">
                      <span class="pname">
                        <span class="pcat" style={`--c:var(--cat-${categoryOf(t.id)}-fg)`}>
                          <Icon name={categoryOf(t.id)} size={16} label={categoryLabel(categoryOf(t.id))} />
                        </span>
                        {themeName(t.id)}
                      </span>
                    </th>
                    <td class="r num" data-label="Complaints">{num(t.complaints)}</td>
                    <td class="r num" data-label="Share">{percent(t.share)}</td>
                    <td class="r num" data-label="Share ratio">{t.recent_complaints >= MIN_RECENT && t.recent_prr != null ? `${t.recent_prr}×` : "–"}</td>
                    <td class="status">
                      {t.flagged && (
                        <span>
                          <strong>BrakeNews flag</strong>{t.flagged_since && ` · First signal: ${monthLabel(t.flagged_since)}`}
                          {t.rising && " · Recent surge"}
                          {t.recall_risk != null && <><br /><span class="muted">Model estimate of a matched recall within 24 months: {percent(t.recall_risk)}</span></>}
                          {report && <><br /><a href={`/investigations/${report.slug}/`}>Read the report</a></>}
                        </span>
                      )}
                      {t.recalls.length > 0 && (
                        <span>
                          NHTSA recall{" "}
                          {t.recalls.map((id, i) => (
                            <>{i > 0 && ", "}<span class="nowrap">#<a class="mono" href={`#recall-${id}`}>{id}</a></span></>
                          ))}
                        </span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <p class="small muted">
          AI groups complaints by meaning; the groups are approximate. Share ratio compares the
          problem’s share of this vehicle’s complaints with its share on other vehicles over the
          last 24 months (shown from 3 recent complaints). A 2× ratio means twice the complaint share,
          not twice the failure risk. Flags mark unusual shares or recent surges after an AI review
          of the complaint content. “First signal” does not mean the pattern has persisted continuously.
          <a href="/method/#model">How recall estimates are calculated</a>.
        </p>
      </>
    )}
  </section>

  <section aria-labelledby="recalls">
    <h2 id="recalls">Recalls</h2>
    {recalls.length === 0 ? (
      <p>No safety recalls naming the {name} are listed in the data through {monthLabel(m.data_through, true)}. Check your VIN with NHTSA for current information; an empty list is not a safety assessment.</p>
    ) : (
      <ul class="recalls">
        {recalls.map((r) => <RecallItem id={r.id} recall={m.recalls[r.id]} make={nhtsaMake} model={nhtsaModel} />)}
      </ul>
    )}
  </section>

  {m.years.length > 1 && (
    <section aria-labelledby="years">
      <h2 id="years">Other model years</h2>
      <ul class="years">
        {m.years.map((o) => (
          <li>
            {o.model_year === y.model_year ? (
              <span class="year current" aria-current="page">{o.model_year}</span>
            ) : (
              <a class="year" href={yearUrl(m, o.model_year)}>
                {o.model_year}
                <span class="muted small"> {num(o.complaints)}</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="about small" aria-labelledby="about">
    <h2 id="about">About this data</h2>
    <p>
      NHTSA complaints and recalls through {monthLabel(m.data_through, true)}. Complaints are
      counted once each, however many components they name. Original complaints are on{" "}
      <a href={nhtsaVehicleUrl(v)} rel="noopener">NHTSA's page for the {name}</a>.
    </p>
    <p>Problem groups are formed by AI and may be approximate. BrakeNews flags unusual complaint patterns; they are not official defect findings. Investigation reports are written and checked by AI, with no human review. Owner reports do not establish that a defect exists.</p>
    <p><a href="/method/">Read the methodology and track record</a> · <a href="https://www.nhtsa.gov/recalls" rel="noopener">Check current recalls by VIN</a></p>
  </section>
</Base>

<style>
  .vehicle-header { padding-block: var(--space-3) var(--space-4); }
  .vehicle-header h1 { max-width: 24ch; font-size: clamp(2.25rem, 2rem + 2vw, 3.5rem); }
  .vehicle-meta { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); color: var(--ink-3); }
  .vehicle-meta span, .vehicle-meta a { display: inline-flex; align-items: center; gap: 6px; }
  .report-nav { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); border-block: 1px solid var(--border); padding-block: var(--space-2); margin-bottom: var(--space-5); }
  .report-nav a { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--text-sm); font-weight: 600; text-decoration: none; }
  .report-nav a:hover { text-decoration: underline; }
  .overview-heading h2 { margin: 0 0 var(--space-2); }
  .tile .value a { text-decoration: none; }
  .tile .value a:hover { text-decoration: underline; }
  .summary-grid { display: grid; gap: var(--space-3); margin-top: var(--space-4); }
  .summary-card { padding: var(--space-4); display: flex; flex-direction: column; min-width: 0; }
  .summary-label { display: flex; align-items: center; gap: var(--space-2); color: var(--ink-3); font-size: var(--text-xs); margin: 0 0 var(--space-2); }
  .summary-label :global(.icon) { color: var(--link); }
  .summary-card h3 { font-size: var(--text-xl); margin: 0 0 var(--space-3); }
  .summary-list { padding: 0; margin: 0 0 var(--space-3); list-style: none; }
  .summary-list li { padding-block: var(--space-3); border-top: 1px solid var(--border); font-size: var(--text-sm); }
  .ranked li { display: flex; align-items: flex-start; gap: 12px; }
  .rank { display: inline-grid; place-items: center; flex: none; width: 28px; height: 28px; border-radius: var(--radius-sm); background: var(--surface-2); color: var(--ink-3); font-weight: 600; }
  .summary-detail { display: block; color: var(--ink-3); font-size: var(--text-xs); margin-top: var(--space-1); }
  .recall-excerpt { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .summary-warning { display: block; color: var(--critical); font-size: var(--text-xs); margin-top: var(--space-1); }
  .summary-footer { margin-top: auto; padding-top: var(--space-2); font-size: var(--text-sm); }
  .investigation-link { display: inline-block; margin-top: 6px; font-size: var(--text-xs); }
  .next-step { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-4); padding: var(--space-4); background: var(--brand-soft); border-radius: var(--radius); }
  .next-step > div { flex: 1 1 20rem; }
  .next-step p { color: var(--ink-2); margin: var(--space-1) 0 0; max-width: 65ch; }
  .context-note { margin-top: var(--space-3); }
  .problems tr:target { outline: 2px solid var(--link); outline-offset: -2px; background: var(--brand-soft); }
  @media (min-width: 1000px) { .summary-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .summary-card, .next-step { padding: var(--space-3); } .next-step .btn { width: 100%; } }
  .overline {
    margin: 0;
  }
  .sub {
    margin: 0 0 var(--space-4);
  }
  .callout {
    margin: 0 0 var(--space-3);
  }
  .reports ul {
    margin: var(--space-1) 0 0;
    padding-left: 1.25rem;
  }
  .tiles {
    margin-top: var(--space-4);
  }
  .nowrap {
    white-space: nowrap;
  }
  .pname {
    display: inline-flex;
    align-items: flex-start;
    gap: var(--space-2);
  }
  .pcat {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 26px;
    height: 26px;
    margin-top: -2px;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--c);
  }
  .table-wrap {
    overflow-x: auto;
  }
  .problems {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .problems th,
  .problems td {
    text-align: left;
    vertical-align: top;
    padding: 12px var(--space-3);
    border-bottom: 1px solid var(--border);
  }
  .problems tbody tr:last-child > * {
    border-bottom: 0;
  }
  .problems thead th {
    font-weight: 600;
    color: var(--ink-2);
    font-size: var(--text-xs);
    background: var(--surface-2);
    border-bottom-color: var(--border);
  }
  .problems tbody th {
    font-weight: 500;
  }
  .problems .r {
    text-align: right;
    white-space: nowrap;
  }
  @media (max-width: 40rem) {
    .problems thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .problems tr {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, auto)) 1fr;
      column-gap: 1rem;
      gap: var(--space-1) var(--space-3);
      border-bottom: 1px solid var(--border);
      padding: 12px var(--space-3);
    }
    .problems th,
    .problems td {
      border: 0;
      padding: 0;
    }
    .problems tbody th,
    .problems td.status {
      grid-column: 1 / -1;
    }
    .problems td.status:empty {
      display: none;
    }
    .problems td.r {
      text-align: left;
    }
    .problems td[data-label]::before {
      content: attr(data-label);
      display: block;
      color: var(--ink-3);
      font-size: var(--text-xs);
    }
    .problems .status {
      min-width: 0;
    }
  }
  .problems tr.flagged th {
    font-weight: 700;
  }
  .problems tr.flagged {
    background: var(--brand-soft);
  }
  .status {
    min-width: 11rem;
  }
  abbr {
    text-decoration: underline dotted;
    cursor: help;
  }
  .recalls {
    list-style: none;
    padding: 0;
  }
  .years {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .year {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease);
  }
  a.year:hover {
    border-color: var(--link);
  }
  .year.current {
    background: var(--pill);
    font-weight: 600;
  }
  .about {
    margin-top: var(--space-6);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
    color: var(--ink-2);
  }
  .about h2 {
    font-size: var(--text-lg);
  }
</style>
