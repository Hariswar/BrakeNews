---
// One page per published investigation report (pipeline/export.py).
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import AboutData from "../../components/AboutData.astro";
import CategoryChip from "../../components/CategoryChip.astro";
import ConfidenceBadge from "../../components/ConfidenceBadge.astro";
import Crumbs from "../../components/Crumbs.astro";
import Icon from "../../components/Icon.astro";
import InfoTip from "../../components/InfoTip.astro";
import MonthlyChart from "../../components/MonthlyChart.astro";
import TrendTag from "../../components/TrendTag.astro";
import {
  dateLabel, monthLabel, nhtsaRecallUrl, nhtsaVehicleUrl, num, percent, plural, vehicleName,
} from "../../lib/format";
import { findVehicleUrl } from "../../lib/vehicles";

export async function getStaticPaths() {
  const reports = await getCollection("investigations");
  return reports.map((r) => ({ params: { slug: r.data.slug }, props: { report: r.data } }));
}

interface Props {
  report: CollectionEntry<"investigations">["data"];
}
const { report: r } = Astro.props;
const s = r.signal;
const vehicle = vehicleName(r.vehicle);
const theme = r.theme.name;

const description = r.headline.length > 160 ? `${r.headline.slice(0, 157).trimEnd()}…` : r.headline;

const RELATION_ORDER = ["covers_this_problem", "similar_problem_other_vehicle", "unrelated"];
const recalls = [...r.recalls].sort(
  (a, b) => RELATION_ORDER.indexOf(a.relation) - RELATION_ORDER.indexOf(b.relation),
);

// The earlier of the two flags: the disproportionality signal or the vehicle's own surge.
const flags = [s.signal_since, s.surge_since].filter((m): m is string => !!m).sort();
const flagged = flags[0] ?? null;

const severity = [
  s.crashes != null && plural(s.crashes, "crash", "crashes"),
  s.fires != null && plural(s.fires, "fire"),
  s.injured != null && plural(s.injured, "injury", "injuries"),
  s.deaths != null && plural(s.deaths, "death"),
].filter(Boolean) as string[];

const hasRisk = s.recall_risk != null;
const vehicleUrl = await findVehicleUrl(r.vehicle.make, r.vehicle.model, r.vehicle.model_year);

// Long summaries enumerate groups as "(1) ... (2) ...": give each group its own paragraph.
const summary = r.summary.split(/\s+(?=\(\d+\)\s)/);
---

<Base title={`${vehicle}: ${theme.toLowerCase()} | BrakeNews`} description={description}>
  <Crumbs items={[{ label: "Reports", href: "/reports/" }, { label: `${vehicle}: ${theme.toLowerCase()}` }]} />

  <article>
    <header class="report-head">
      <p class="overline">
        {vehicleUrl ? <a href={vehicleUrl} class="vehicle-link">{vehicle}</a> : vehicle}
      </p>
      <h1>{theme}</h1>
      <div class="tags">
        <CategoryChip themeId={r.theme.id} />
        <span class="reading">{r.reading.label}</span>
        <ConfidenceBadge level={r.reading.confidence} id="report" />
        {s.surging && <TrendTag />}
      </div>
    </header>

    <AboutData>
      <p><strong>AI-written report.</strong>{" "}{r.provenance.note}</p>
    </AboutData>

    <p class="lead headline">{r.headline}</p>

    <section aria-labelledby="numbers">
      <h2 id="numbers">The numbers</h2>
      <dl class="tiles">
        {s.complaints != null && (
          <div class="tile">
            <dt>Complaints</dt>
            <dd class="value num">{num(s.complaints)}</dd>
            <dd class="note">
              {s.first_received && s.last_received
                ? `Received ${monthLabel(s.first_received)} to ${monthLabel(s.last_received)}`
                : "About this problem on this vehicle"}
            </dd>
          </div>
        )}
        {s.last_3_months != null && (
          <div class="tile">
            <dt>Last 3 months</dt>
            <dd class="value num">{num(s.last_3_months)}</dd>
            <dd class="note">
              {s.last_3_months_expected != null
                ? `About ${s.last_3_months_expected} expected from this vehicle's own history`
                : "Complaints in the latest three months"}
            </dd>
          </div>
        )}
        {s.recent_prr != null && (
          <div class="tile">
            <dt>Compared with other vehicles</dt>
            <dd class="value num">{s.recent_prr}×</dd>
            <dd class="note">
              How much more often this vehicle's complaints from the last 24 months are about this
              problem than other vehicles' complaints are
            </dd>
          </div>
        )}
        {hasRisk && (
          <div class="tile">
            <dt>
              Estimated recall chance
              <InfoTip id="risk-tip" label="About the estimated recall chance">
                A model's estimate, not a prediction. Most flagged problems in past data were never
                recalled.
              </InfoTip>
            </dt>
            <dd class="value num">{percent(s.recall_risk!)}</dd>
            <dd class="note">
              Model's estimate that a recall covering this problem follows within 24 months
              {s.risk_rank != null && s.ranked_pairs != null &&
                ` (rank ${num(s.risk_rank)} of ${num(s.ranked_pairs)} vehicle-problem pairs)`}
            </dd>
          </div>
        )}
      </dl>
      {severity.length > 0 && (
        <p class="small muted">
          Reported in these complaints: {severity.join(", ")}.
          {s.checked_complaints != null && s.checked_on_theme != null &&
            ` An AI check found ${num(s.checked_on_theme)} of the ${num(s.checked_complaints)} recent complaints are about this problem on this vehicle.`}
        </p>
      )}

      <MonthlyChart
        monthly={s.monthly_complaints}
        through={r.data_through}
        marker={flagged ? { month: flagged, label: `Flagged ${monthLabel(flagged)}` } : null}
        caption={`Complaints per month about this problem, ${vehicle}`}
      />
    </section>

    <section aria-labelledby="report" class="prose">
      <h2 id="report">What owners report</h2>
      {summary.map((para) => <p>{para}</p>)}
      <h3>How it fails</h3>
      <p>{r.failure_pattern}</p>
      <h3>Safety risk</h3>
      <p>{r.safety_risk}</p>
    </section>

    {r.findings.length > 0 && (
      <section aria-labelledby="findings" class="prose">
        <h2 id="findings">Findings and the complaints behind them</h2>
        <ol class="findings">
          {r.findings.map((f) => (
            <li>
              <p>{f.text}</p>
              {f.complaints.length > 0 && (
                <p class="cites small muted">
                  NHTSA complaint {f.complaints.length === 1 ? "number" : "numbers"}:{" "}
                  <span class="mono">{f.complaints.join(", ")}</span>
                </p>
              )}
            </li>
          ))}
        </ol>
      </section>
    )}

    {recalls.length > 0 && (
      <section aria-labelledby="recalls" class="prose">
        <h2 id="recalls">Recalls checked</h2>
        <ul class="recalls">
          {recalls.map((rc) => (
            <li>
              <p class="recall-head">
                <span class="recall-id">
                  NHTSA recall #<a class="mono" href={nhtsaRecallUrl(rc.campaign_id)} rel="noopener">{rc.campaign_id}</a>
                </span>
                <span class={`relation rel-${rc.relation}`}>{rc.relation_label}</span>
              </p>
              <p>{rc.note}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {r.open_questions.length > 0 && (
      <section aria-labelledby="questions" class="prose">
        <h2 id="questions">Open questions</h2>
        <ul>
          {r.open_questions.map((q) => <li>{q}</li>)}
        </ul>
      </section>
    )}

    <section aria-labelledby="about" class="about small prose">
      <h2 id="about">About this report</h2>
      <ul>
        {r.data_through && <li>NHTSA data through {monthLabel(r.data_through, true)}.</li>}
        <li>
          Written {dateLabel(r.provenance.written)} by {r.provenance.investigator_model}
          {r.provenance.reviewer_model && `, fact-checked by a separate ${r.provenance.reviewer_model} reviewer`}.
          Not reviewed by a person.
        </li>
        {vehicleUrl && (
          <li>
            Everything else owners report about this vehicle, and its recalls:{" "}
            <a href={vehicleUrl}>{vehicle}</a>.
          </li>
        )}
        <li>
          The complaint numbers above are NHTSA's own; the original complaints and any open
          recalls are on <a href={nhtsaVehicleUrl(r.vehicle)} rel="noopener">NHTSA's page for the {vehicle}</a>.
        </li>
      </ul>
    </section>
  </article>
</Base>

<style>
  .report-head {
    margin-bottom: var(--space-4);
  }
  .report-head .overline {
    margin: 0;
  }
  .vehicle-link {
    color: inherit;
  }
  .report-head h1 {
    margin-top: var(--space-1);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .reading {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 2px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink);
  }
  .headline {
    margin-top: var(--space-4);
    font-family: var(--font-display-stack);
    font-size: var(--text-xl);
    line-height: 1.4;
    color: var(--ink);
  }
  .tile dt {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
  .findings {
    list-style: none;
    padding: 0;
    counter-reset: f;
  }
  .findings li {
    position: relative;
    padding-left: 44px;
    margin-bottom: var(--space-4);
    counter-increment: f;
  }
  .findings li::before {
    content: counter(f);
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: var(--surface-2);
    font-weight: 700;
    font-size: var(--text-sm);
  }
  .findings p {
    margin-bottom: var(--space-1);
  }
  .cites {
    overflow-wrap: anywhere;
  }
  .recalls {
    list-style: none;
    padding: 0;
  }
  .recalls li {
    border-top: 1px solid var(--border);
    padding-top: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .recall-head {
    display: flex;
    gap: var(--space-2) var(--space-3);
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
  }
  .recall-id {
    font-size: var(--text-sm);
    color: var(--ink-2);
  }
  .recall-id a {
    font-weight: 700;
  }
  .relation {
    display: inline-flex;
    min-height: 26px;
    align-items: center;
    padding: 2px 10px;
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 600;
    background: var(--surface-2);
    color: var(--ink-2);
  }
  .rel-covers_this_problem {
    background: var(--brand-soft);
    color: var(--ink);
  }
  ul li {
    margin-bottom: var(--space-2);
  }
  .about {
    margin-top: var(--space-6);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
    color: var(--ink-2);
  }
  .about h2 {
    font-size: var(--text-lg);
  }
</style>
