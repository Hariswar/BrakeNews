---
// The honest note on how a report was made, as a visible callout rather than fine print.
import Icon from "./Icon.astro";

interface Props {
  title?: string;
}
const { title = "About this data" } = Astro.props;
---

<aside class="callout about-data" aria-label={title}>
  <Icon name="file-check" size={22} />
  <div>
    <strong class="callout-title">{title}</strong>
    <slot />
  </div>
</aside>
