---
// Make -> model -> year, filled from /vehicles/index.json. Each field stays disabled until the
// one before it is chosen. Loading and error states are announced; without JavaScript the
// browse link still reaches every vehicle.
import Icon from "./Icon.astro";

interface Props {
  idPrefix?: string; // keeps label ids unique if the picker appears twice on a page
}
const { idPrefix = "pick" } = Astro.props;
---

<form class="picker" data-picker action="/vehicles/" aria-label="Look up a vehicle" novalidate>
  <div class="quick-search">
    <label for={`${idPrefix}-search`}>Search by year, make or model</label>
    <div class="search-field">
    <input
      id={`${idPrefix}-search`} type="search" data-search disabled
      placeholder="Try 2025 Honda Pilot" autocomplete="off" spellcheck="false"
      role="combobox" aria-autocomplete="list" aria-expanded="false"
      aria-controls={`${idPrefix}-results`} aria-describedby={`${idPrefix}-search-status`}
    />
    <ul id={`${idPrefix}-results`} class="search-results" role="listbox" aria-label="Matching vehicles" hidden></ul>
    </div>
    <p id={`${idPrefix}-search-status`} class="hint" data-search-status role="status" aria-live="polite">Loading vehicle search…</p>
  </div>
  <p class="picker-divider">Or choose step by step</p>
  <div class="fields">
    <div class="field">
      <label for={`${idPrefix}-make`}>Make</label>
      <div class="select-wrap">
        <select id={`${idPrefix}-make`} name="make" disabled required>
          <option value="">Loading makes…</option>
        </select>
        <span class="spinner" data-spinner aria-hidden="true"></span>
      </div>
    </div>
    <div class="field">
      <label for={`${idPrefix}-model`}>Model</label>
      <div class="select-wrap">
        <select id={`${idPrefix}-model`} name="model" disabled required>
          <option value="">Choose a make first</option>
        </select>
      </div>
    </div>
    <div class="field">
      <label for={`${idPrefix}-year`}>Model year</label>
      <div class="select-wrap">
        <select id={`${idPrefix}-year`} name="year" disabled required>
          <option value="">Choose a model first</option>
        </select>
      </div>
    </div>
    <button type="submit" class="btn btn-primary go" disabled>
      See reports <Icon name="arrow-right" size={18} />
    </button>
  </div>
  <p class="hint" data-status role="status" aria-live="polite">Loading the vehicle list…</p>
  <noscript>
    <p class="hint">The lookup needs JavaScript. <a href="/vehicles/">Browse all makes</a> instead.</p>
  </noscript>
</form>

<script>
  import { indexVehicles, searchVehicles, type VehicleIndex, type SearchVehicle } from "../lib/vehicle-search";
  const HINT =
    "Opens the vehicle's page: the problems owners report, flags, recalls and any reports.";

  function fill(select: HTMLSelectElement, prompt: string, options: [string, string][]) {
    select.replaceChildren(new Option(prompt, ""), ...options.map(([label, value]) => new Option(label, value)));
    select.disabled = options.length === 0;
  }

  // Share a single request when more than one picker is present.
  const indexRequest = fetch("/vehicles/index.json").then((r) => {
    if (!r.ok) throw new Error(String(r.status));
    return r.json() as Promise<VehicleIndex>;
  });
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-picker]")) {
    const [make, model, year] = ["make", "model", "year"].map(
      (n) => form.elements.namedItem(n) as HTMLSelectElement,
    );
    const button = form.querySelector<HTMLButtonElement>("button.go")!;
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const spinner = form.querySelector<HTMLElement>("[data-spinner]");
    const search = form.querySelector<HTMLInputElement>("[data-search]")!;
    const results = form.querySelector<HTMLUListElement>(".search-results")!;
    const searchStatus = form.querySelector<HTMLElement>("[data-search-status]")!;
    let index: VehicleIndex = [];
    let searchable: SearchVehicle[] = [];
    let matches: SearchVehicle[] = [];
    let active = -1;
    const closeSearch = () => {
      results.hidden = true;
      search.setAttribute("aria-expanded", "false");
      search.removeAttribute("aria-activedescendant");
      active = -1;
      for (const option of results.children) option.setAttribute("aria-selected", "false");
    };
    const setActive = (next: number) => {
      active = next;
      for (const [i, option] of [...results.children].entries()) option.setAttribute("aria-selected", String(i === active));
      if (active >= 0) {
        search.setAttribute("aria-activedescendant", results.children[active].id);
        results.children[active].scrollIntoView({ block: "nearest" });
      }
    };
    const showSearch = () => {
      closeSearch();
      matches = searchVehicles(searchable, search.value);
      results.replaceChildren(...matches.map((vehicle, i) => {
        const option = document.createElement("li");
        option.id = `${results.id}-${i}`;
        option.setAttribute("role", "option");
        option.setAttribute("aria-selected", "false");
        option.textContent = vehicle.label;
        // Keep focus on the combobox until navigation.
        option.addEventListener("pointerdown", (e) => e.preventDefault());
        option.addEventListener("click", () => { location.href = vehicle.href; });
        return option;
      }));
      if (!search.value.trim()) {
        searchStatus.textContent = "Type a vehicle name. Use ↑ and ↓ to explore matches, then Enter to open.";
        return;
      }
      results.hidden = matches.length === 0;
      search.setAttribute("aria-expanded", String(matches.length > 0));
      searchStatus.textContent = matches.length
        ? `${matches.length === 8 ? "First 8" : matches.length} matching ${matches.length === 1 ? "vehicle" : "vehicles"}. Add a year or model to narrow your search.`
        : "No matching vehicles in our index. Try another spelling or use the dropdowns. Only vehicles with at least 25 complaints are listed.";
    };
    const models = () => index.find((m) => m[1] === make.value)?.[2] ?? [];
    const update = () => {
      button.disabled = !year.value;
    };

    indexRequest
      .then((data) => {
        index = data;
        if (!index.length) throw new Error("empty");
        fill(make, "Choose a make", index.map(([label, slug]) => [label, slug]));
        searchable = indexVehicles(index);
        search.disabled = false;
        searchStatus.textContent = "Type a vehicle name. Use ↑ and ↓ to explore matches, then Enter to open.";
        status.textContent = HINT;
      })
      .catch(() => {
        make.replaceChildren(new Option("Unavailable", ""));
        status.replaceChildren(
          "Couldn't load the vehicle list. ",
          Object.assign(document.createElement("a"), { href: "/vehicles/", textContent: "Browse all makes" }),
          " instead.",
        );
        form.classList.add("is-error");
        search.placeholder = "Vehicle search unavailable";
        searchStatus.replaceChildren("Couldn't load search. ", Object.assign(document.createElement("a"), { href: "/vehicles/", textContent: "Browse all makes" }), " instead.");
      })
      .finally(() => spinner?.remove());

    search.addEventListener("input", showSearch);
    search.addEventListener("focus", () => { if (search.value.trim()) showSearch(); });
    search.addEventListener("blur", closeSearch);
    search.addEventListener("keydown", (e) => {
      if (e.key === "Escape") { e.preventDefault(); closeSearch(); return; }
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        if (results.hidden) showSearch();
        if (matches.length) {
          const direction = e.key === "ArrowDown" ? 1 : -1;
          const next = active < 0
            ? (direction === 1 ? 0 : matches.length - 1)
            : (active + direction + matches.length) % matches.length;
          setActive(next);
        }
      }
      if (e.key === "Enter") {
        e.preventDefault();
        if (results.hidden) showSearch();
        if (active >= 0) location.href = matches[active].href;
        else if (matches.length === 1) location.href = matches[0].href;
        else if (matches.length > 1) setActive(0);
      }
    });

    make.addEventListener("change", () => {
      fill(model, make.value ? "Choose a model" : "Choose a make first", models().map(([label, slug]) => [label, slug]));
      fill(year, "Choose a model first", []);
      update();
    });
    model.addEventListener("change", () => {
      const years = models().find((m) => m[1] === model.value)?.[2] ?? [];
      fill(year, model.value ? "Choose a year" : "Choose a model first", years.map((y) => [String(y), String(y)]));
      update();
    });
    year.addEventListener("change", update);
    window.addEventListener("pageshow", (e) => {
      // Back/Forward may restore this exact form with its submit button still disabled.
      if (e.persisted) {
        update();
        if (index.length) status.textContent = HINT;
        closeSearch();
      }
    });
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!year.value) return;
      button.disabled = true;
      status.textContent = "Opening…";
      location.href = `/vehicles/${make.value}/${model.value}/${year.value}/`;
    });
  }
</script>

<style>
  .search-field { position: relative; margin-top: 6px; }
  .quick-search input {
    display: block; width: 100%; min-height: 50px;
    padding: 10px 14px; border: 1px solid var(--border-strong); border-radius: var(--radius-sm);
    background: var(--surface); color: var(--ink); font: inherit;
  }
  .quick-search input:disabled { background: var(--surface-2); }
  .quick-search input::placeholder { color: var(--ink-3); opacity: 1; }
  .search-results {
    position: absolute; top: 100%; inset-inline: 0; z-index: 20;
    max-height: 280px; overflow-y: auto; list-style: none; margin: 0; padding: var(--space-1);
    background: var(--surface); border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm); box-shadow: var(--shadow-md);
  }
  .search-results[hidden] { display: none; }
  .search-results :global(li) { padding: 12px; border-radius: var(--radius-sm); cursor: pointer; font-size: var(--text-sm); }
  .search-results :global(li:hover), .search-results :global(li[aria-selected="true"]) { background: var(--brand-soft); color: var(--ink); }
  .picker-divider { display: flex; align-items: center; gap: 12px; margin: var(--space-4) 0 var(--space-3); color: var(--ink-3); font-size: var(--text-xs); }
  .picker-divider::before, .picker-divider::after { content: ""; height: 1px; flex: 1; background: var(--border); }
  .picker {
    container-type: inline-size;
  }
  .fields {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr;
  }
  @container (min-width: 640px) {
    .fields {
      grid-template-columns: 1fr 1fr 1fr auto;
      align-items: end;
    }
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink);
  }
  .select-wrap {
    position: relative;
  }
  select {
    width: 100%;
    min-height: 48px;
    padding: 0 40px 0 14px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background-color: var(--surface);
    background-image: linear-gradient(45deg, transparent 50%, var(--ink-2) 50%),
      linear-gradient(135deg, var(--ink-2) 50%, transparent 50%);
    background-position:
      calc(100% - 20px) 50%,
      calc(100% - 15px) 50%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
    color: var(--ink);
    font: 500 var(--text-base) / 1.2 var(--font-body-stack);
    appearance: none;
    cursor: pointer;
    transition: border-color var(--dur) var(--ease);
  }
  select:hover:not(:disabled) {
    border-color: var(--ink-2);
  }
  select:disabled {
    background-color: var(--surface-2);
    color: var(--ink-3);
    cursor: not-allowed;
  }
  .spinner {
    position: absolute;
    right: 36px;
    top: 50%;
    width: 16px;
    height: 16px;
    margin-top: -8px;
    border: 2px solid var(--border);
    border-top-color: var(--link);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .go {
    min-height: 48px;
    width: 100%;
  }
  @container (min-width: 640px) {
    .go {
      width: auto;
    }
  }
  .hint {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--ink-3);
  }
  .is-error .hint {
    color: var(--ink);
  }
</style>
